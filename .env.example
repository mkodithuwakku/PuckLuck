# Copy to .env and fill in. .env is git-ignored — never commit it (SRS §7.1).

# Yahoo Fantasy OAuth 2.0 app credentials (Phase 2)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# Yahoo league/team keys, e.g. "449.l.12345" / "449.l.12345.t.7"
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=

# Local paths (defaults shown)
PUCKLUCK_DB_PATH=data/puckluck.sqlite3
PUCKLUCK_CACHE_DIR=data/cache
